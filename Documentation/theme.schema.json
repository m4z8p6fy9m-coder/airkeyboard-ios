{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AirKeyboard theme v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "minimumIOS": {
      "type": "integer",
      "const": 18
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]*\\S[^\\u0000-\\u001F\\u007F-\\u009F]*$"
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "background": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}(?![\\s\\S])"
    },
    "key": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?(?![\\s\\S])"
    },
    "primary": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}(?![\\s\\S])"
    },
    "secondary": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}(?![\\s\\S])"
    },
    "accent": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}(?![\\s\\S])"
    },
    "pressed": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?(?![\\s\\S])"
    },
    "border": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?(?![\\s\\S])"
    },
    "cornerRadius": {
      "type": "number",
      "minimum": 0,
      "maximum": 20
    },
    "spacing": {
      "type": "number",
      "minimum": 2,
      "maximum": 8
    },
    "padding": {
      "type": "number",
      "minimum": 2,
      "maximum": 12
    },
    "borderWidth": {
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "font": {
      "type": "string",
      "enum": [
        "rounded",
        "standard",
        "monospaced"
      ]
    },
    "appearance": {
      "type": "string",
      "enum": [
        "dark",
        "light"
      ]
    },
    "layout": {
      "type": "string",
      "enum": [
        "qwerty",
        "qwertz"
      ]
    },
    "soundPack": {
      "type": "string",
      "enum": [
        "tactile",
        "mechanical",
        "pop",
        "digital",
        "silent"
      ]
    },
    "rendering": {
      "type": "object",
      "required": [
        "surface",
        "specialKey",
        "followsSystem"
      ],
      "properties": {
        "surface": {
          "type": "string",
          "enum": [
            "solid",
            "glass"
          ]
        },
        "specialKey": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?(?![\\s\\S])"
        },
        "light": {
          "type": "object",
          "required": [
            "background",
            "key",
            "specialKey",
            "primary",
            "secondary",
            "border",
            "pressed",
            "accent"
          ],
          "properties": {
            "background": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}(?![\\s\\S])"
            },
            "key": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?(?![\\s\\S])"
            },
            "specialKey": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?(?![\\s\\S])"
            },
            "primary": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}(?![\\s\\S])"
            },
            "secondary": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}(?![\\s\\S])"
            },
            "border": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?(?![\\s\\S])"
            },
            "pressed": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?(?![\\s\\S])"
            },
            "accent": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}(?![\\s\\S])"
            }
          }
        },
        "followsSystem": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "followsSystem": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "light"
            ]
          }
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "minimumIOS",
    "id",
    "name",
    "description",
    "background",
    "key",
    "primary",
    "secondary",
    "accent",
    "pressed",
    "border",
    "cornerRadius",
    "spacing",
    "padding",
    "borderWidth",
    "font",
    "appearance",
    "layout",
    "soundPack"
  ],
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "required": [
          "rendering"
        ],
        "properties": {
          "rendering": {
            "properties": {
              "surface": {
                "const": "glass"
              }
            }
          }
        }
      },
      "then": {},
      "else": {
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}(?![\\s\\S])"
          },
          "pressed": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}(?![\\s\\S])"
          },
          "border": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}(?![\\s\\S])"
          },
          "rendering": {
            "properties": {
              "specialKey": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}(?![\\s\\S])"
              },
              "light": {
                "properties": {
                  "key": {
                    "type": "string",
                    "pattern": "^#[0-9A-Fa-f]{6}(?![\\s\\S])"
                  },
                  "specialKey": {
                    "type": "string",
                    "pattern": "^#[0-9A-Fa-f]{6}(?![\\s\\S])"
                  },
                  "border": {
                    "type": "string",
                    "pattern": "^#[0-9A-Fa-f]{6}(?![\\s\\S])"
                  },
                  "pressed": {
                    "type": "string",
                    "pattern": "^#[0-9A-Fa-f]{6}(?![\\s\\S])"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
